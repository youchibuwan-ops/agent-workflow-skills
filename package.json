{
  "name": "agent-workflow-skills-checks",
  "private": true,
  "description": "Development checks and reproducible examples; not the skill runtime",
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "assemble:example": "node scripts/assemble-binder.mjs",
    "render:example": "node scripts/render-example.mjs",
    "build:dsh": "node scripts/build-dsh-variant.mjs",
    "test:dsh": "node --test scripts/dsh.test.mjs",
    "test:workflow": "node --test scripts/workflow-gate.test.mjs evals/discovery-gates/dsh-dispatch.test.mjs",
    "test:hosts": "node --test hosts/core/*.test.mjs hosts/codex/*.test.mjs hosts/dsh/native.test.mjs hosts/dsh/launcher.test.mjs hosts/dsh/cli.test.mjs",
    "test:host-native": "node --test hosts/dsh/profile-loader.test.mjs hosts/dsh/source-confirmation.test.mjs",
    "test:host-preview": "node --test scripts/host-preview.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@resvg/resvg-js": "2.6.2",
    "markdownlint": "0.42.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "katex": "0.19.0",
    "zod": "4.6.6"
  }
}
